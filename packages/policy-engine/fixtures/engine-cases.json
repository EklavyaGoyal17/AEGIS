{
  "description": "Engine-level integration fixtures for the backend: evaluating `input` against `policySet` with @aegis/policy-engine must produce exactly `expect`. Inputs are EvaluationInput objects as the backend would assemble them. Tenant: tnt_acme",
  "policySet": {
    "tenantId": "tnt_acme",
    "revision": 1,
    "policies": [
      {
        "policyId": "data-export",
        "version": 1,
        "document": {
          "schemaVersion": "aegis.policy/v1",
          "rules": [
            {
              "actions": [
                "crm.customers.read"
              ],
              "resourceTypes": [
                "crm.customer_table"
              ],
              "id": "allow-read",
              "effect": "ALLOW",
              "sensitivity": {
                "max": "confidential"
              }
            },
            {
              "actions": [
                "crm.customers.export"
              ],
              "resourceTypes": [
                "crm.customer_table"
              ],
              "id": "allow-small-internal-export",
              "effect": "ALLOW",
              "when": {
                "all": [
                  {
                    "lte": [
                      {
                        "ref": "resource.attributes.recordCount"
                      },
                      {
                        "value": 1000
                      }
                    ]
                  },
                  {
                    "eq": [
                      {
                        "ref": "resource.attributes.destination"
                      },
                      {
                        "value": "internal"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "actions": [
                "crm.customers.export"
              ],
              "resourceTypes": [
                "crm.customer_table"
              ],
              "id": "approve-bulk-or-external",
              "effect": "REQUIRE_APPROVAL",
              "when": {
                "any": [
                  {
                    "gt": [
                      {
                        "ref": "resource.attributes.recordCount"
                      },
                      {
                        "value": 1000
                      }
                    ]
                  },
                  {
                    "ne": [
                      {
                        "ref": "resource.attributes.destination"
                      },
                      {
                        "value": "internal"
                      }
                    ]
                  }
                ]
              },
              "approval": {
                "ttlSeconds": 3600
              }
            },
            {
              "actions": [
                "crm.customers.export"
              ],
              "resourceTypes": [
                "*"
              ],
              "id": "deny-restricted-export",
              "effect": "DENY",
              "sensitivity": {
                "min": "restricted"
              }
            },
            {
              "actions": [
                "*"
              ],
              "resourceTypes": [
                "*"
              ],
              "id": "deny-untrusted-network",
              "effect": "DENY",
              "when": {
                "eq": [
                  {
                    "ref": "env.networkZone"
                  },
                  {
                    "value": "untrusted"
                  }
                ]
              }
            }
          ],
          "actionCatalog": [
            "crm.customers.read",
            "crm.customers.export",
            "crm.customers.delete"
          ]
        }
      }
    ]
  },
