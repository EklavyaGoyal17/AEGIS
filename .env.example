# AEGIS configuration reference. Copy the variables you need into your process environment or secret
# manager. Never commit real values. For local development, `npm run dev:init` generates every secret below
# into the git-ignored .backend-tmp/ directory and Docker Compose reads them from there.

# ── API and gateway (services/api, services/gateway) ────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Runtime role (least privilege). Migrations use a separate owner credential.
DATABASE_URL=postgresql://aegis_app:<password>@127.0.0.1:5432/aegis
# Bearer tokens are verified against this issuer/audience with RS256.
JWT_ISSUER=https://identity.aegis.local.invalid
JWT_AUDIENCE=aegis-local
# Exactly one of: an HTTPS JWKS endpoint, or a trusted local public key file.
JWT_JWKS_URL=
JWT_PUBLIC_KEY_FILE=.backend-tmp/dev/public.pem
# >= 32 characters; signs pagination cursors.
CURSOR_SIGNING_KEY=<generated-by-dev-init>
# Gateway only: the isolated demo connector.
DEMO_TOOL_ORIGIN=http://127.0.0.1:3002
DEMO_TOOL_SECRET=<generated-by-dev-init>
# Policy engine selection. Default: the canonical @aegis/policy-engine. The fixed demo fixture is opt-in
# and rejected in production.
ENABLE_LOCAL_DEMO_POLICY=false
AEGIS_CANONICAL_ENGINE_MODULE=
# Seeding a demo tenant is refused unless explicitly requested outside production.
AEGIS_DEV_SEED=false
# Optional OpenTelemetry export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=aegis-api

# ── Console (apps/console, server side) ─────────────────────────────────────────────────────────────
# Where the console's server-side proxy sends API calls. The browser never calls the API directly.
AEGIS_API_URL=http://127.0.0.1:3000
# forward    = production: an upstream SSO/OIDC proxy sets the operator's Authorization header
# dev-signer = local development only (refused when NODE_ENV=production)
AEGIS_CONSOLE_AUTH_MODE=dev-signer
AEGIS_CONSOLE_DEV_SIGNING_KEY_FILE=.backend-tmp/dev/private.pem
AEGIS_CONSOLE_DEV_SUBJECT=demo-human

# ── Console (build time) ─────────────────────────────────────────────────────────────────────────────
# true = in-memory simulated data, clearly labelled in the UI. Default false (real API).
NEXT_PUBLIC_DEMO_MODE=false

# ── Demo agent (apps/demo-agent) ─────────────────────────────────────────────────────────────────────
AEGIS_GATEWAY_URL=http://127.0.0.1:3001
# Production: a workload-identity token for the agent. Local: leave empty to sign with the dev key.
AEGIS_AGENT_TOKEN=
AEGIS_DEMO_AUTO_APPROVE=false
