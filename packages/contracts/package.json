{
  "name": "@aegis/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "AEGIS v1 shared API contracts: OpenAPI, JSON Schema, runtime validators, canonicalization and execution-authorization primitives.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    },
    "./openapi/aegis-v1.yaml": "./openapi/aegis-v1.yaml",
    "./schemas/aegis-v1.schema.json": "./schemas/aegis-v1.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi",
    "schemas",
    "examples",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "npm run build && node scripts/generate.mjs",
    "check:generated": "npm run build && node scripts/generate.mjs --check",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run check:generated"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "yaml": "2.9.1"
  }
}
