{
  "schemaVersion": "aegis.policy/v1",
  "actionCatalog": [
    "crm.customers.read",
    "crm.customers.export",
    "crm.customers.delete"
  ],
  "decisionTtlSeconds": 60,
  "rules": [
    {
      "id": "allow-crm-read",
      "effect": "ALLOW",
      "actions": [
        "crm.customers.read"
      ],
      "resourceTypes": [
        "crm.customer_table"
      ],
      "sensitivity": {
        "max": "confidential"
      }
    },
    {
      "id": "allow-small-internal-export",
      "effect": "ALLOW",
      "actions": [
        "crm.customers.export"
      ],
      "resourceTypes": [
        "crm.customer_table"
      ],
      "when": {
        "all": [
          {
            "lte": [
              {
                "ref": "resource.attributes.recordCount"
              },
              {
                "value": 1000
              }
            ]
          },
          {
            "eq": [
              {
                "ref": "resource.attributes.destination"
              },
              {
                "value": "internal"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "require-approval-bulk-export",
      "description": "Bulk or external exports need a human approver.",
      "effect": "REQUIRE_APPROVAL",
      "actions": [
        "crm.customers.export"
      ],
      "resourceTypes": [
        "crm.customer_table"
      ],
      "when": {
        "any": [
          {
            "gt": [
              {
                "ref": "resource.attributes.recordCount"
              },
              {
                "value": 1000
              }
            ]
          },
          {
            "ne": [
              {
                "ref": "resource.attributes.destination"
              },
              {
                "value": "internal"
              }
            ]
          }
        ]
      },
      "approval": {
        "ttlSeconds": 3600
      }
    },
    {
      "id": "deny-restricted-export",
      "effect": "DENY",
      "actions": [
        "crm.customers.export"
      ],
      "resourceTypes": [
        "*"
      ],
      "sensitivity": {
        "min": "restricted"
      }
    },
    {
      "id": "deny-delete-outside-business-hours",
      "effect": "DENY",
      "actions": [
        "crm.customers.delete"
      ],
      "resourceTypes": [
        "*"
      ],
      "when": {
        "not": {
          "eq": [
            {
              "ref": "env.businessHours"
            },
            {
              "value": true
            }
          ]
        }
      }
    },
    {
      "id": "deny-untrusted-network",
      "effect": "DENY",
      "actions": [
        "*"
      ],
      "resourceTypes": [
        "*"
      ],
      "when": {
        "eq": [
          {
            "ref": "env.networkZone"
          },
          {
            "value": "untrusted"
          }
        ]
      }
    }
  ]
}
